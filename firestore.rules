rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can read and write only their own user document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Product categories are public to read (needed for the shop pages)
    // but can only be changed via the Firebase console / admin SDK.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
